# -----------------------------
# Supabase (Cloud Project)
# -----------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Mobile app uses ANON key only (safe-ish, still treat carefully)
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# IMPORTANT: Service role key MUST NEVER go into the mobile app.
# Use it ONLY for local ingest worker / server-side jobs because it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# -----------------------------
# OpenStreetMap Overpass (Optional Ingestion)
# -----------------------------
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# -----------------------------
# Ingest worker tuning
# -----------------------------
INGEST_BATCH_LIMIT="10"
INGEST_SLEEP_MS="3000"
INGEST_MAX_RUNTIME_MIN="0"
INGEST_LOG_EVERY="1"
RETRO_CLEANUP_ON_START="true"
RETRO_CLEANUP_ACTION="unpublish"
RETRO_CLEANUP_LIMIT="5000"
FORCE_COVERAGE_ON_START="true"
FORCE_COVERAGE_LIMIT="300"
FORCE_COVERAGE_MAX_PLACES="20"
FORCE_COVERAGE_MERKEZ_ONLY="true"
FORCE_COVERAGE_EVERY_BATCH="20"
MERKEZ_BOOST_ON_START="true"
MERKEZ_BOOST_EVERY_BATCH="5"
STUCK_REQUEUE_EVERY_BATCH="5"
STUCK_REQUEUE_MINUTES="20"
NORMALIZE_AFTER_BATCH="true"
NORMALIZE_LIMIT="300"
AUTO_APPROVE_SAFE="true"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# -----------------------------
# IAP / Billing (Supabase Edge Function secrets)
# supabase secrets set KEY=VALUE
# -----------------------------

# RevenueCat — server-side (secret key, App Store Connect'te degil, RC dashboard'da)
REVENUECAT_SECRET_KEY=""

# Apple App Store Server API v2 (App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
APPLE_PRIVATE_KEY=""   # -----BEGIN PRIVATE KEY----- blogu, newline \n ile

# Apple verifyReceipt fallback (deprecated — v2 calisiyorsa kullanilmaz)
APPLE_SHARED_SECRET=""
APPLE_BUNDLE_ID="com.yunusgunes.routevia"

# Google Play (Service Account JSON — Cloud Console → IAM → Service Accounts)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PACKAGE_NAME="com.yunusgunes.routevia"

# Pexels (Cover images)
PEXELS_API_KEY=""

# Firebase (Push notifications — service account JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# -----------------------------
# Mobile build (--dart-define)
# flutter build ... --dart-define=REVENUECAT_ANDROID_KEY=goog_xxx ...
# -----------------------------
REVENUECAT_ANDROID_KEY=""
REVENUECAT_IOS_KEY=""
APP_STORE_URL=""   # https://apps.apple.com/app/routevia/idXXXXXXX
